{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FluxCast",
  "identifier": "dev.fluxcast.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FluxCast",
        "width": 730,
        "height": 470,
        "minWidth": 460,
        "minHeight": 320,
        "center": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "rpm",
      "appimage"
    ],
    "icon": [
      "icons/icon.png"
    ]
  }
}
